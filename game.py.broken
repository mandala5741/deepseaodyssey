app = Flask(__name__)
app.config['JSON_AS_ASCII'] = False

# ==================== 认证装饰器 ====================
def require_auth(f):
    @wraps(f)
    def decorated(*args, **kwargs):
        agent_id = request.headers.get('X-Agent-ID') or request.args.get('agent_id')
        if not agent_id:
            return jsonify({"error": "缺少认证"}), 401
        
        player = get_player_by_agent(agent_id)
        if not player:
            return jsonify({"error": "玩家不存在"}), 404
        
        g.player_id = player['id']
        g.agent_id = agent_id
        g.player = player
        return f(*args, **kwargs)
    return decorated


# ==================== 认证接口 ====================
@app.route('/api/auth/register', methods=['POST'])
def register():
    """注册新玩家"""
    data = request.get_json(force=True) or {}
    agent_id = data.get('agent_id') or request.headers.get('X-Agent-ID')
    name = data.get('name')
    password = data.get('password')
    
    if not agent_id:
        return jsonify({"error": "缺少agent_id"}), 400
    # 密码可选，不填则自动生成UUID
    if password and len(password) < 6:
        return jsonify({"error": "密码至少6位"}), 400
    
    result, msg = create_player(agent_id, name, password)
    if not result:
        return jsonify({"error": msg}), 400
    
    return jsonify({
        "success": True,
        "player": result,
        "message": msg,
        "password": result.get("password")  # 返回明文密码，仅此次可见
    })


@app.route('/api/auth/login', methods=['POST'])
def login():
    """登录获取玩家数据"""
    data = request.get_json(force=True) or {}
    agent_id = data.get('agent_id')
    password = data.get('password')
    
    if not agent_id or not password:
        return jsonify({"error": "缺少账号或密码"}), 400
    
    user = get_user_by_agent(agent_id)
    if not user:
        return jsonify({"error": "账号不存在"}), 404
    
    # 验证密码
    if user.get('password_hash') and not verify_password(password, user['password_hash']):
        return jsonify({"error": "密码错误"}), 401
    
    player = get_player_by_agent(agent_id)
    if not player:
        return jsonify({"error": "玩家数据不存在"}), 404
    
    player = dict(get_player_full(player['id']))
    g.agent_id = agent_id
    
    restore_energy(g.player_id)
    player = dict(get_player_full(player['id']))
    
    # 获取保护盾状态
    shield = get_protection_status(g.player_id)
    
    return jsonify({
        "success": True,
        "player": {
            "id": player['id'],
            "name": player['name'],
            "level": player['level'],
            "exp": player['xp'],
            "gold": player['gold'],
            "silver": player['silver'],
            "hp": player['hp'],
            "max_hp": player['max_hp'],
            "energy": player.get('energy') or 0,
            "max_energy": player.get('max_energy') or 120,
            "power": player['power'],
            "faction": player['faction'],
            "faction_name": player.get('faction_name') or '',
        return jsonify({"error": "账号不存在"}), 401
            "ladder_points": player['power'],
            "vip_level": player['vip_level'],
            "title": None,
            "honor": 1,
        },
        "protection": shield
    })


