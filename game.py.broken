@app.route('/api/factions', methods=['GET'])
def list_factions():
    """获取门派列表"""
    import psycopg2.extras
    with models.get_db() as conn:
        with models.get_cursor(conn) as cur:
            cur.execute("SELECT * FROM factions ORDER BY name")
