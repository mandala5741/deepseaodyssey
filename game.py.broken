@app.route('/api/messages/inbox', methods=['GET'])
@require_auth
def messages_inbox():
    """获取收件箱"""
    import psycopg2.extras
    with models.get_db() as conn:
        with models.get_cursor(conn) as cur:
            cur.execute("""
                SELECT m.*, p.name as sender_name
                FROM player_messages m
                JOIN players p ON m.sender_id = p.id
                WHERE m.receiver_id = %s
                ORDER BY m.created_at DESC LIMIT 50
            """, (g.player_id,))
            msgs = [dict(r) for r in cur.fetchall()]
            return jsonify({"success": True, "messages": msgs})


@app.route('/api/messages/outbox', methods=['GET'])
@require_auth
def messages_outbox():
    """获取发件箱"""
    import psycopg2.extras
    with models.get_db() as conn:
        with models.get_cursor(conn) as cur:
            cur.execute("""
                SELECT m.*, p.name as receiver_name
                FROM player_messages m
                JOIN players p ON m.receiver_id = p.id
                WHERE m.sender_id = %s
                ORDER BY m.created_at DESC LIMIT 50
            """, (g.player_id,))
            msgs = [dict(r) for r in cur.fetchall()]
            return jsonify({"success": True, "messages": msgs})


@app.route('/api/messages/favorite', methods=['POST'])
@require_auth
def messages_favorite():
    """收藏/取消收藏邮件"""
    data = request.get_json(force=True) or {}
    msg_id = data.get('message_id')
    if not msg_id:
        return jsonify({"success": False, "reason": "缺少message_id"})
    import psycopg2.extras
    with models.get_db() as conn:
        with models.get_cursor(conn) as cur:
            cur.execute("""
                UPDATE player_messages SET is_favorite = NOT is_favorite
                WHERE id = %s AND receiver_id = %s
                RETURNING is_favorite
            """, (msg_id, g.player_id))
            row = cur.fetchone()
            conn.commit()
            if not row:
                return jsonify({"success": False, "reason": "邮件不存在"})
            return jsonify({"success": True, "is_favorite": row['is_favorite']})


@app.route('/api/messages/delete', methods=['POST'])
@require_auth
def messages_delete():
    """删除邮件（收藏的不删除）"""
    data = request.get_json(force=True) or {}
    message_ids = data.get('message_ids', [])
    if not message_ids:
        return jsonify({"success": False, "reason": "缺少message_ids"})
    import psycopg2.extras
    with models.get_db() as conn:
        with models.get_cursor(conn) as cur:
            cur.execute("""
                DELETE FROM player_messages
                WHERE id IN %s AND receiver_id = %s AND is_favorite = FALSE
            """, (tuple(message_ids), g.player_id))
            deleted = cur.rowcount
            conn.commit()
            return jsonify({"success": True, "deleted": deleted})


# ==================== 挑战/PVP ====================
@app.route('/api/pvp/challenge', methods=['POST'])
@require_auth
def pvp_challenge():
    """发起PVP挑战"""
    data = request.get_json(force=True) or {}
    defender_id = data.get('defender_id')
    
    if not defender_id:
        return jsonify({"success": False, "reason": "缺少被挑战者ID"})
    
    # 检查体力
    restore_energy(g.player_id)
    player = dict(get_player_full(g.player_id))
    if (player.get('energy') or 0) < 10:
        return jsonify({"success": False, "reason": "体力不足10点，无法挑战"})
    
    # 检查保护盾
    shield = get_protection_status(defender_id)
    if shield.get('active'):
        return jsonify({"success": False, "reason": "对方正在保护盾中"})
    
    # 简单模拟战斗
    import random, uuid
    challenger = dict(get_player_full(g.player_id))
    defender = dict(get_player_full(defender_id))
    
    # 保护盾检查 - 挑战者
    my_shield = get_protection_status(g.player_id)
    shield_broken = False
    if my_shield.get('active'):
        with get_db() as conn:
            with get_cursor(conn) as cur:
                cur.execute("UPDATE protection_shield SET is_active = FALSE, last_shield_end = NOW(), shield_end = NOW() - INTERVAL '1 second' WHERE player_id = %s", (g.player_id,))
        shield_broken = True
    
    # 伤害计算
    atk = challenger['claw_power'] + challenger['swim_speed'] // 2
    dfs = defender['shell'] + defender['shrimp_wit'] // 2
    damage = max(1, atk - dfs // 2 + random.randint(-5, 10))
    
    # 判断输赢
    my_power = challenger['power']
    opp_power = defender['power']
    win_prob = my_power / (my_power + opp_power + 1)
    is_win = random.random() < win_prob
    
    result = "win" if is_win else "lose"
    
    # 奖励/惩罚
    gold_change = 50 if is_win else -20
    xp_change = 30 if is_win else 10
    
    if is_win:
        add_gold(g.player_id, gold_change)
        add_xp(g.player_id, xp_change)
    else:
        spend_gold(g.player_id, abs(gold_change))
        add_xp(g.player_id, xp_change)
    
    # 扣体力10点
    with get_db() as conn:
        with get_cursor(conn) as cur:
            cur.execute("UPDATE players SET energy = GREATEST(0, energy - 10), last_energy_restore = NOW() WHERE id = %s", (g.player_id,))
    
    # 记录
    battle_id = f"pvp_{uuid.uuid4().hex[:12]}"
    record_challenge(battle_id, g.player_id, defender_id, result,
                     damage_dealt=damage, reward_gold=gold_change,
                     reward_xp=xp_change, battle_data={
                         "challenger_power": my_power,
                         "defender_power": opp_power,
                         "damage": damage
                     })
    
    # 更新任务进度
    if is_win:
        update_task_progress(g.player_id, 'pvp_win', 1)
    else:
        update_task_progress(g.player_id, 'pvp_lose', 1)
    
    challenger_name = challenger.get('name', '神秘掠夺者')
    if result == 'win':
        mail_content = "⚔️ 【挑战结果】你被 " + challenger_name + " 挑战！结果：<b style='color:#ff6b7a'>你败了</b>！<br>造成了 " + str(damage) + " 点伤害。"
    else:
        mail_content = "⚔️ 【挑战结果】你被 " + challenger_name + " 挑战！结果：<b style='color:#7bed9f'>你守住了</b>！<br>对手造成了 " + str(damage) + " 点伤害。"
    send_message(g.player_id, defender_id, mail_content, "challenge_result")

    return jsonify({
        "success": True,
        "result": result,
        "battle_id": battle_id,
        "gold_change": gold_change,
        "xp_change": xp_change,
        "damage_dealt": damage,
        "shield_broken": shield_broken
    })


# ==================== 搜索玩家 ====================
@app.route('/api/players/search', methods=['GET'])
def search_players():
    """搜索玩家"""
    name = request.args.get('name', '')
    if len(name) < 1:
        return jsonify({"success": False, "reason": "名字太短"})
    
    import psycopg2.extras
    with models.get_db() as conn:
        with models.get_cursor(conn) as cur:
            cur.execute("""
                SELECT id, name, level, power, faction
                FROM players WHERE name LIKE %s LIMIT 20
            """, (f"%{name}%",))
            players = [dict(r) for r in cur.fetchall()]
            return jsonify({"success": True, "players": players})


