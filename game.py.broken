@app.route('/api/player/profile', methods=['GET'])
@require_auth
def profile():
    """获取完整玩家资料"""
    player = dict(get_player_full(g.player_id))
    
    return jsonify({
        "success": True,
        "player": {
            "id": player['id'],
            "name": player['name'],
            "level": player['level'],
            "exp": player['xp'],
            "gold": player['gold'],
            "silver": player['silver'],
            "hp": player['hp'],
            "max_hp": player['max_hp'],
            "energy": player.get('energy') or 0,
            "max_energy": player.get('max_energy') or 120,
            "power": player['power'],
            # 六维
            "claw_power": player['claw'],
            "shell": player['shell'],
            "swim_speed": player['speed'],
            "shrimp_wit": player['wisdom'],
            "perception": player['perception'],
            "luck": player['luck'],
            # 门派
            "faction": player['faction'],
            "faction_name": player.get('faction_name') or '',
            # 天梯
            "ladder_tier": 'bronze_i',
            "ladder_points": player['power'],
            "pvp_points": player['wins'],
            # VIP
            "vip_level": player['vip_level'],
            # 称号名誉
            "title": None,
            "honor_level": 1,
            # 时间
            "created_at": str(player['created_at']),
        },
        "protection": get_protection_status(g.player_id)
    })


@app.route('/api/player/stats', methods=['POST'])
@require_auth
def update_stats():
    """更新玩家属性点（升级后加点）"""
    data = request.get_json(force=True) or {}
    # 可分配点数
    available = data.get('claw_power', 0) + data.get('shell', 0) + data.get('swim_speed', 0) + \
                data.get('shrimp_wit', 0) + data.get('perception', 0) + data.get('luck', 0)
    
    player = dict(get_player_full(g.player_id))
    if available > player.get('stat_points', 0):
        return jsonify({"success": False, "reason": "分配点数不足"})
    
    stats = {}
    for attr in ['claw_power', 'shell', 'swim_speed', 'shrimp_wit', 'perception', 'luck']:
        if attr in data:
            stats[attr] = data[attr]
    
    update_player_stats(g.player_id, stats)
    return jsonify({"success": True})


